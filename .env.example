# 값은 넣지 말고 이름만 둔다. 실제 값은 .env(git 제외)에.

# 배포·서버 연동
# APP_ENV=                 # dev(기본) | prod
ENGINE_SERVICE_TOKEN=      # /internal/v1 Bearer 토큰(서버와 같은 값). prod 필수
# DATABASE_URL=            # 기본 sqlite:///./diagnosis.db, 운영 postgresql+psycopg://…
# DB_CREATE_ALL=           # 운영은 false로 두고 alembic upgrade head
# DB_POOL_SIZE=
# DB_MAX_OVERFLOW=
# DB_POOL_TIMEOUT=
# MAX_QUESTIONS=           # 판정 보드 진행 표시의 질문 상한(기본 30)

# 서류(성적서) 업로드·자동 읽기
# MAX_UPLOAD_BYTES=        # 기본 10485760
# DOCUMENT_TABLE_READING=  # 기본 true: 글자 있는 PDF 표를 엔진 안에서 읽는다(외부 전송 없음)
# 스캔본 PDF·사진 읽기(Azure Document Intelligence). 켜고 키를 넣을 때만 과금되고 원본 이미지를 보낸다
# ALLOW_DOCUMENT_OCR=      # 기본 false
AZURE_DOCINTEL_ENDPOINT=
AZURE_DOCINTEL_API_KEY=
# AZURE_DOCINTEL_MODEL=    # 기본 prebuilt-layout
# OCR_TIMEOUT_SECONDS=     # 기본 120

# 법령 수집(개발 PC에서만, tools/collect_law.py). 배포 서버는 부르지 않는다
LAW_API_OC=

# LLM 단계(의도·추출 에이전트, 질문 문장)에서 쓸 예정. 지금 엔진은 읽지 않는다
LLM_PROVIDER=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=
