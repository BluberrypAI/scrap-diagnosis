# 값은 넣지 말고 이름만 둔다. 실제 값은 .env(git 제외)에.
# Azure AI Foundry v1 엔드포인트(…/openai/v1/…)와 기존 Azure OpenAI 엔드포인트를 모두 지원한다.
LLM_PROVIDER=azure
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
# KB_DIR=data/real
# MAX_QUESTIONS=12

# 배포·서버 연동
# APP_ENV=dev                      # dev | prod
ENGINE_SERVICE_TOKEN=              # /internal/v1 Bearer 토큰. prod 필수(서버와 같은 값)
# DATABASE_URL=sqlite:///var/app.db  # 운영: postgresql+psycopg://<user>:<password>@<host>:5432/<db>
# DB_CREATE_ALL=true               # 운영은 false + alembic upgrade head
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_TIMEOUT=30
# THREAD_LIMIT=40                  # 동시에 처리하는 턴 수 상한
# LLM_TIMEOUT_SECONDS=60           # 운영 권장 12 (docs/perf/turn-latency.md)
# MAX_UPLOAD_BYTES=10485760

# AI 전송 정책
# ALLOW_DOCUMENT_LLM=false         # 서류 원문을 AI로 보낼지
# TRACE_STORE_PROMPTS=true         # false면 Trace에 가린 프롬프트도 남기지 않음

# 보충 설명의 마지막 수단: 준비된 설명이 없을 때만 웹 검색(none|naver, 기본 none)
WEB_SEARCH_PROVIDER=none
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 업로드한 PDF·이미지에서 시험성적서 표 값을 자동으로 읽어 검수 대기 후보로 저장(글자 있는 PDF는 로컬)
# DOCUMENT_TABLE_READING=true
# 서류 표 인식(Azure Document Intelligence). 엔진과 같은 구독·리전의 리소스. 켜면 원본 쪽 이미지를 보낸다
# ALLOW_DOCUMENT_OCR=false
AZURE_DOCINTEL_ENDPOINT=
AZURE_DOCINTEL_API_KEY=
# AZURE_DOCINTEL_MODEL=prebuilt-layout
# OCR_TIMEOUT_SECONDS=120
