{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/BluberrypAI/resource_engine/schemas/assessment_record.schema.json",
  "title": "판정 기록 (assessment record) v1",
  "description": "이후 단계(시설 추천·수거·처리 지원)가 읽는 고정 형식. status가 DETERMINED이고 trust.level이 기준 이상인 항목만 자동으로 쓴다.",
  "type": "object",
  "required": ["record_version", "engine_version", "rule_db_version", "as_of", "record_hash", "status", "complete",
               "material", "items", "hazards", "open_items", "use_rule"],
  "properties": {
    "record_version": {"const": "1"},
    "engine_version": {"type": "string"},
    "rule_db_version": {"type": "string"},
    "as_of": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "record_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"enum": ["DETERMINED", "NEED_INFO", "NEED_TEST", "NEED_EXPERT", "OUT_OF_SCOPE"]},
    "complete": {"type": "boolean"},
    "material": {
      "oneOf": [
        {"type": "null"},
        {"type": "object", "required": ["id", "label", "composite", "catalog_review"],
         "properties": {"id": {"type": "string"}, "label": {"type": "string"}, "composite": {"type": "boolean"},
                        "catalog_review": {"type": "string"}}}
      ]
    },
    "items": {
      "type": "object",
      "required": ["waste_status", "applicable_law", "business_waste", "designated", "code", "recycling"],
      "additionalProperties": {"$ref": "#/$defs/item"}
    },
    "hazards": {"type": "object", "additionalProperties": {"$ref": "#/$defs/fact"}},
    "open_items": {
      "type": "array",
      "items": {"type": "object", "required": ["fact", "question", "state", "need"],
                "properties": {"fact": {"type": ["string", "null"]}, "question": {"type": "string"},
                               "state": {"enum": ["MISSING", "UNKNOWN", "CONFLICT", "AUTHORITY"]},
                               "need": {"enum": ["USER", "DOCUMENT", "TEST", "AUTHORITY"]},
                               "test": {"type": "object"}}}
    },
    "use_rule": {"type": "string"}
  },
  "$defs": {
    "fact": {
      "type": "object", "required": ["state"],
      "properties": {"state": {"enum": ["VALUE", "UNKNOWN", "CONFLICT", "NOT_ASKED"]},
                     "source": {"enum": ["USER", "DOCUMENT", "TEST", "MATERIAL", "DERIVED"]}}
    },
    "basis": {
      "type": "object", "required": ["source_id", "title", "location", "quote", "evidence"],
      "properties": {"evidence": {"type": "string"}, "review": {"type": ["string", "null"]}}
    },
    "item": {
      "type": "object", "required": ["title", "status"],
      "properties": {
        "title": {"type": "string"},
        "status": {"enum": ["DETERMINED", "PROVISIONAL", "OPEN", "NOT_APPLICABLE"]},
        "value": {"type": ["string", "null"]},
        "label": {"type": ["string", "null"]},
        "basis": {"type": "array", "items": {"$ref": "#/$defs/basis"}},
        "facts_used": {"type": "object", "additionalProperties": {"$ref": "#/$defs/fact"}},
        "trust": {
          "type": "object", "required": ["rules", "basis", "level", "reasons"],
          "properties": {"rules": {"enum": ["REVIEWED", "UNVERIFIED"]}, "basis": {"enum": ["LAW", "INTERPRETIVE"]},
                         "facts": {"enum": ["TEST", "DOCUMENT", "USER", null]},
                         "selection": {"enum": ["AUTO", "USER_SELECTED"]},
                         "level": {"enum": ["high", "medium", "low"]}, "reasons": {"type": "array"}}
        },
        "code": {"type": "string"}, "name": {"type": "string"}, "how": {"enum": ["AUTO", "USER_SELECTED"]},
        "allowed": {"type": "array"}, "prohibited": {"type": "boolean"}, "reasons": {"type": "array"},
        "waiting_for": {"type": "string"}
      }
    }
  }
}
